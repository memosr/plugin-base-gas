{
  "name": "@memosr/plugin-base-gas",
  "version": "0.1.0",
  "description": "elizaOS plugin: live Base gas, transaction cost in USD, ready-to-sign fees, cross-chain comparison and best time to transact. Paid per call in USDC over x402, no API key.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "images",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "elizaos-plugin",
    "eliza-plugin",
    "elizaos",
    "base",
    "gas",
    "x402",
    "usdc",
    "agents"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/memosr/plugin-base-gas.git"
  },
  "homepage": "https://base-gas-x402.vercel.app",
  "license": "MIT",
  "author": "memosr",
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@elizaos/core": ">=1.0.0"
  },
  "dependencies": {
    "@x402/evm": "^2.28.0",
    "@x402/fetch": "^2.28.0",
    "viem": "^2.57.10"
  },
  "devDependencies": {
    "@elizaos/core": "^1.7.2",
    "@types/node": "^26.6.5",
    "tsup": "^9.0.0",
    "typescript": "5.9"
  },
  "agentConfig": {
    "pluginType": "elizaos:plugin:1.0.0",
    "pluginParameters": {
      "BASE_GAS_PRIVATE_KEY": {
        "type": "string",
        "description": "Private key of a Base wallet holding a little USDC (no ETH needed). Falls back to EVM_PRIVATE_KEY. Use a dedicated wallet with small funds.",
        "required": false,
        "sensitive": true
      },
      "BASE_GAS_MAX_USD_PER_CALL": {
        "type": "string",
        "description": "Hard cap per payment in USD. Default 0.05; routes cost 0.002 to 0.02.",
        "required": false
      }
    }
  }
}
